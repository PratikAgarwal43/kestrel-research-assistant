# =====================================================================
# Kestrel Research Assistant - Environment Configuration
# =====================================================================
# Copy this file to .env and insert your real API keys.
# NEVER commit your actual API keys or secrets to version control.

# Google Gemini API Key (Required for LLM generation)
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Tracing & Observability (Optional, enables execution tracing)
# Set LANGSMITH_TRACING=true to trace multi-agent execution
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=kestrel-research-assistant
